# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point    fstype     device                 device2                        flags
/boot            emmc      /dev/block/bootdevice/by-name/boot                     flags=slotselect
/data            ext4      /dev/block/bootdevice/by-name/userdata                 flags=encryptable=ice
/misc            emmc      /dev/block/bootdevice/by-name/misc
/system          ext4      /dev/block/bootdevice/by-name/system                   flags=display="System";slotselect
/system_image    emmc      /dev/block/bootdevice/by-name/system                   flags=display="System_Image";slotselect
/efs1            emmc      /dev/block/bootdevice/by-name/modemst1                 flags=display="modemst1";backup=1;
/efs2            emmc      /dev/block/bootdevice/by-name/modemst2                 flags=display="modemst2";backup=1;subpartitionof=/efs1
/persist         ext4      /dev/block/bootdevice/by-name/persist                  flags=display="Persist";backup=1
/firmware        ext4      /dev/block/bootdevice/by-name/modem                    flags=display="Modem";slotselect
/fsg             emmc      /dev/block/bootdevice/by-name/fsg                      flags=display="Fsg"backup=1;slotselect
/vendor          ext4      /dev/block/bootdevice/by-name/vendor                   flags=display="Vendor";backup=1;slotselect
/vendor_image    emmc      /dev/block/bootdevice/by-name/vendor                   flags=display="Vendor_Image";backup=1;slotselect
/dsp             ext4      /dev/block/bootdevice/by-name/dsp                      flags=display="Dsp";backup=1;slotselect
/metadata        emmc      /dev/block/bootdevice/by-name/metadata
/logo            emmc      /dev/block/bootdevice/by-name/logo                     flags=display="Logo";backup=1;slotselect
/keymaster       emmc      /dev/block/bootdevice/by-name/keymaster                flags=slotselect
/bt_firmware     ext4      /dev/block/bootdevice/by-name/bluetooth                flags=display="Bluetooth";backup=1;slotselect

# Removable storage
/external_sd     auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1             flags=display="MicroSD Card";storage;wipeingui;removable
/usb-otg         auto      /dev/block/sda1         /dev/block/sda                 flags=display="USB OTG";removable;storageOTG"
